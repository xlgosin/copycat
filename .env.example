# API secrets stay on this server. Enable USD-M Futures trading, not withdrawals.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# paper | testnet | live. Restart after changing; each mode has a separate ledger.
COPYCAT_MODE=paper
# Second explicit switch required for real orders; UI Start is still required.
LIVE_TRADING_ENABLED=false
BINANCE_TESTNET_URL=https://demo-fapi.binance.com
SOURCE_DB=../binance-copy-monitor/data/copy_monitor.db
# Standalone collection: set SOURCE_DB=data/source.db and run python collect.py.
STANDALONE_SOURCE_DB=data/source.db
SOURCE_POLL_SECONDS=60
PORTFOLIO_ID=5075281354358777856
COPY_CAPITAL=100
COPY_MULTIPLIER=3
FUTURES_LEVERAGE=3
MAX_GROSS_NOTIONAL=300
MAX_SIGNAL_AGE_SECONDS=180
MAX_SOURCE_AGE_SECONDS=180
MAX_PRICE_DEVIATION_PERCENT=1
POLL_SECONDS=5
# Generate with: python3 -c 'import secrets; print(secrets.token_hex(24))'
# Blank: generated once in data/admin-token; printed on startup.
ADMIN_TOKEN=
HOST=127.0.0.1
PORT=8010

# Reuse ONLY DingTalk credentials from the previous crawler's .env.
DINGTALK_ENABLED=true
DINGTALK_ENV_FILE=../binance-copy-monitor/.env
# Optional overrides; blank uses previous .env.
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
