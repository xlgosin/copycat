# API secrets stay on this server. Enable USD-M Futures trading, not withdrawals.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# paper | testnet | live. Restart after changing; each mode has a separate ledger.
COPYCAT_MODE=paper
# Second explicit switch required for real orders; UI Start is still required.
LIVE_TRADING_ENABLED=false
BINANCE_TESTNET_URL=https://demo-fapi.binance.com
# Optional Binance REST proxy (requests). Leave blank to connect directly, no proxy.
# Example: http://127.0.0.1:64655
HTTP_PROXY=
HTTPS_PROXY=
SOURCE_DB=data/source.db
# Standalone collection: set SOURCE_DB=data/source.db and run python collect.py.
STANDALONE_SOURCE_DB=data/source.db
SOURCE_POLL_SECONDS=10
# Backoff after a failed collector poll (page timeout / busy). Keep well below MAX_SOURCE_AGE_SECONDS.
SOURCE_FAILURE_WAIT_SECONDS=30
# Exit after this many seconds without a successful poll; systemd restarts the collector container.
SOURCE_RESTART_AFTER_SECONDS=60
# Verified source-position snapshot JSON; see README. Weekly history alone is insufficient.
SOURCE_BASELINE_FILE=
PORTFOLIO_ID=5075281354358777856
COPY_CAPITAL=100
COPY_MULTIPLIER=1
FUTURES_LEVERAGE=5
MAX_GROSS_NOTIONAL=500
MAX_SIGNAL_AGE_SECONDS=180
# Allow brief collector/page timeouts without pausing copy-trading.
MAX_SOURCE_AGE_SECONDS=300
MAX_PRICE_DEVIATION_PERCENT=1
POLL_SECONDS=5
# After a transient crawler outage, resume copying without another UI Start.
AUTO_RESUME_ON_SOURCE_RECOVERY=true
# Generate with: python3 -c 'import secrets; print(secrets.token_hex(24))'
# Blank: generated once in data/admin-token; printed on startup.
ADMIN_TOKEN=
HOST=0.0.0.0
PORT=8010

# Configure the robot directly in CopyCat/.env.
DINGTALK_ENABLED=true
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# Optional, read-only AlphaFox latency probe. Paste only the Cookie request
# header from your own logged-in AlphaFox session; never commit or print it.
ALPHAFOX_COOKIE=
